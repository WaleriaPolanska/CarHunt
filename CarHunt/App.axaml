<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CarHunt"
             x:Class="CarHunt.App"
             RequestedThemeVariant="Light">
             <!-- Light, not Default: the UI hard-codes light fields and white cards, so
                  following a system dark theme leaves theme-derived parts (placeholders,
                  dropdowns, scrollbars) painted for a dark background they never get. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>